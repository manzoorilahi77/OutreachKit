# The Outreach Kit database (MySQL 8.0 or newer). Copy this file to .env.local and fill in the real values.
# Never commit .env.local. On the server these are set as environment variables (see docs/hostinger-install.md once it exists).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<DATABASE_NAME>
DB_USER=<DATABASE_USER>
DB_PASSWORD=<DATABASE_PASSWORD>

# Signs session cookies. 32 or more random characters; REQUIRED in production (the app won't start without it).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<RANDOM_64_HEX_CHARACTERS>

# Optional: show the lead finder's browser window when a run starts from the console.
# SCRAPE_HEADED=1
