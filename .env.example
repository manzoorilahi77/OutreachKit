# Supabase project URL and anon (publishable) key. Safe to expose to the browser: Row Level Security protects the data.
# Without them the app still runs: the playbook, board and kit console work, and sign-in is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put the service-role key in the app's environment. It is used only by tests against the local stack.
